<script>
  (function () {
    'use strict';

    /* 구매 6단계 탭 */
    var tabs = [].slice.call(document.querySelectorAll('.tab'));
    var tabPanels = [].slice.call(document.querySelectorAll('.panel'));
    function showStep(step) {
      tabs.forEach(function (t) {
        var on = t.dataset.step === step;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      tabPanels.forEach(function (p) {
        var on = p.dataset.step === step;
        p.classList.toggle('is-on', on);
        p.hidden = !on;
      });
    }
    tabs.forEach(function (t, idx) {
      t.addEventListener('click', function () { showStep(t.dataset.step); });
      t.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowRight') next = tabs[(idx + 1) % tabs.length];
        if (e.key === 'ArrowLeft') next = tabs[(idx - 1 + tabs.length) % tabs.length];
        if (next) { e.preventDefault(); next.focus(); showStep(next.dataset.step); }
      });
    });

    /* Impact Simulator — 금융그룹 계열사 도입 사례의 간접구매비 절감률 */
    var RATE = 0.142;
    var R = ['r1', 'r2', 'r3'].map(function (id) { return document.getElementById(id); });
    if (!R[0]) return;
    function fmt(n) { return Number(n).toLocaleString('ko-KR'); }
    function one(n) { return Math.round(n * 10) / 10; }
    function calc() {
      var rev = +R[0].value, mg = +R[1].value, ind = +R[2].value;
      // 간접구매 규모가 매출을 넘는 입력은 성립하지 않습니다.
      if (ind > rev) { ind = rev; R[2].value = ind; }
      var save = ind * RATE, op = rev * mg / 100, op2 = op + save;
      document.getElementById('v1').textContent = fmt(rev);
      document.getElementById('v2').textContent = mg.toFixed(1);
      document.getElementById('v3').textContent = fmt(ind);
      document.getElementById('save').textContent = fmt(one(save));
      document.getElementById('op1').textContent = fmt(one(op)) + '억';
      document.getElementById('op2').textContent = fmt(one(op2)) + '억';
      document.getElementById('m1').textContent = mg.toFixed(1) + '%';
      document.getElementById('m2').textContent = (op2 / rev * 100).toFixed(1) + '%';
    }
    R.forEach(function (r) { r.addEventListener('input', calc); });
    calc();
  })();
</script>
