---
import Base from '../../layouts/Base.astro';
import { SITE, CTA } from '../../data/nav';

const title = '벤치마크 리포트 — CFO·구매책임자를 위한 구매 인사이트';
const description =
  '견적 비교부터 공급사 선정, 지출 관리까지 — 기업의 구매가 어떻게 비용 차이를 만드는지 데이터로 확인하세요. 진단 소요 약 1분, 결과는 메일로 발송되며 비용은 무료입니다.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/resource/report#webpage`,
    url: `${SITE.url}/resource/report`,
    name: title,
    description,
    inLanguage: 'ko-KR',
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '리소스' },
      { '@type': 'ListItem', position: 3, name: '벤치마크 리포트', item: `${SITE.url}/resource/report` },
    ],
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="subhero">
    <div class="wrap">
      <nav class="crumb" aria-label="현재 위치">
        <a href="/">홈</a><span class="sep" aria-hidden="true">/</span>
        <span>리소스</span><span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">벤치마크 리포트</span>
      </nav>
      <p class="eyebrow">CFO · 재무 · 구매책임자를 위한 구매 인사이트</p>
      <h1>구매가 바뀌면, 비용 구조가 바뀝니다</h1>
      <p class="lead">견적 비교부터 공급사 선정, 지출 관리까지. 기업의 구매가 어떻게 비용 차이를 만드는지 확인해 보세요.</p>
      <div class="cta-row">
        <a class="cta" href={CTA.diagnosis}>무료 진단 받기</a>
        <a class="cta sec" href={CTA.consult}>도입 상담 신청</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <dl class="glance">
        <div><dt>진단 소요</dt><dd>약 1분</dd></div>
        <div><dt>결과 전달</dt><dd>관리 유형 메일 발송</dd></div>
        <div><dt>비용</dt><dd>무료</dd></div>
      </dl>
      <div class="stub">
        <b>리포트 본문은 준비 중입니다</b>
        <p>
          CFO 세미나 설문 결과와 업종별 간접구매 벤치마크 데이터가 순차적으로 공개됩니다.
          지금 신청하시면 공개 시점에 메일로 먼저 보내 드립니다.
        </p>
      </div>
    </div>
  </section>
</Base>
